{
  "name": "kubepi-cli",
  "version": "0.1.2",
  "description": "KubePi 命令行工具，支持在终端里访问和操作 KubePi（Kubernetes 多集群管理面板），对 AI Agents 友好。",
  "type": "module",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/1Panel-dev/KubePi.git",
    "directory": "cli"
  },
  "keywords": [
    "kubepi",
    "kubernetes",
    "cli",
    "multi-cluster"
  ],
  "bin": {
    "kubepi": "./bin/kubepi.js"
  },
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsup src/index.ts --format esm --out-dir dist --clean",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && node bin/kubepi.js --version"
  },
  "dependencies": {
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0"
  }
}
